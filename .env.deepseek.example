# Copy these values into the ignored root .env file and replace the API key.
AI_PROVIDER=DEEPSEEK
AI_API_KEY=replace-with-your-deepseek-api-key
AI_BASE_URL=https://api.deepseek.com

# Fast mode: low cost, non-thinking.
AI_MODEL_NAME=deepseek-v4-flash
AI_FAST_THINKING=disabled
AI_REASONING_EFFORT=
AI_MAX_COMPLETION_TOKENS=1024

# Deep mode: stronger model with official DeepSeek thinking enabled.
AI_DEEP_MODEL_NAME=deepseek-v4-pro
AI_DEEP_THINKING=enabled
AI_DEEP_REASONING_EFFORT=high
AI_DEEP_MAX_COMPLETION_TOKENS=4096

AI_TEMPERATURE=0.3
AI_TIMEOUT=120s
AI_AGENT_ID=assistant
AGENT_MAX_TOOL_CALLING_ROUND_TRIPS=24
CODING_MAX_TOOL_CALLS=50

# web_search defaults to Tavily and stays disabled until a key is configured.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=TAVILY
WEB_SEARCH_MAX_QUERY_CHARACTERS=400
JINA_API_KEY=
JINA_SEARCH_BASE_URL=https://s.jina.ai/
JINA_SEARCH_TIMEOUT=20s
JINA_MAX_RESULT_CHARACTERS=30000
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com/
TAVILY_SEARCH_DEPTH=basic
TAVILY_TIMEOUT=10s
TOOL_MAX_EVENT_RESULT_CHARACTERS=16384

SANDBOX_ENABLED=true
SANDBOX_OWNER_ID=local-user
SANDBOX_DATA_DIR=../.deep-explore-data
SANDBOX_FULLSTACK_IMAGE=deep-explore/sandbox-fullstack:v1
SANDBOX_COMMAND_TIMEOUT=60s
SANDBOX_NETWORK_MODE=bridge

DB_URL=jdbc:postgresql://localhost:5432/deep_explore
DB_USERNAME=deep_explore
DB_PASSWORD=deep_explore
DB_POOL_SIZE=10

SERVER_PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONVERSATION_MESSAGES=20
CONVERSATION_LOCK_TIMEOUT=5m
