# Any OpenAI-compatible chat completion endpoint can be used.
AI_PROVIDER=OPENAI_COMPATIBLE
AI_API_KEY=replace-me
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL_NAME=gpt-4.1-mini
AI_DEEP_MODEL_NAME=
AI_TEMPERATURE=0.3
AI_MAX_COMPLETION_TOKENS=1024
AI_REASONING_EFFORT=none
AI_DEEP_MAX_COMPLETION_TOKENS=2048
AI_DEEP_REASONING_EFFORT=low
AI_FAST_THINKING=
AI_DEEP_THINKING=
AI_TIMEOUT=60s
AI_AGENT_ID=assistant

# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/deep_explore
DB_USERNAME=deep_explore
DB_PASSWORD=deep_explore
DB_POOL_SIZE=10

# Development defaults
SERVER_PORT=8080
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_CONVERSATION_MESSAGES=20
CONVERSATION_LOCK_TIMEOUT=5m
